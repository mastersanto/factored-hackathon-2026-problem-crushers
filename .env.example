# Copy to .env.local (git-ignored) and fill in. Variables already set in your shell take precedence.

# Anthropic API key. Without it the assistant runs in rules mode (no LLM calls).
ANTHROPIC_API_KEY=

# Key for the check codes printed on transcript PDFs. Without it an ephemeral key is used, and codes stop
# verifying after a restart. Generate one: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
TRANSCRIPT_HMAC_KEY=

# Optional overrides (defaults shown)
# UNDERSTAND_MODEL=claude-haiku-4-5
# PHRASE_MODEL=claude-sonnet-5-5
# LLM_DISABLED=0
# DATA_MIRROR=~/factored-hackathon-2026-scratch/data
# WAREHOUSE_DIR=backend/data/warehouse
# SESSION_TTL_SECONDS=1800
# LOOKBACK_DAYS=90
